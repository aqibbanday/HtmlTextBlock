<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ht="clr-namespace:AqiTechTips;assembly=HtmlTextBlock"
    x:Class="TestApp.WPF.MainWindow"
        Title="MainWindow" Height="250" Width="450">
    <DockPanel>
        <ht:HtmlTextBlock x:Name="htmlTextBlock" HorizontalAlignment="Left" TextWrapping="Wrap" 
                                     Html="{Binding Text, ElementName=tb}"
                                     DockPanel.Dock="Top"
                                     />
        <TextBlock Text="&lt;b&gt; &lt;i&gt; &lt;u&gt; &lt;a href=xx&gt; &lt;br&gt; supported (legacy [b][/b] square-bracket tags also still work)." DockPanel.Dock="Bottom" />
        <TextBox TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible"
            x:Name="tb" Text="The &lt;i&gt;&lt;u&gt;quick brown fox&lt;/u&gt;&lt;/i&gt; jumps over the &lt;b&gt;lazy dog&lt;/b&gt;" />
    </DockPanel>


</Window>
